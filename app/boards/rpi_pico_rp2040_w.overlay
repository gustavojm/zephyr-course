#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    leds {
        compatible = "gpio-leds";
        
        led_red: led_red {
            // gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;         // Ref by gpio label
            // gpios = <&pico_header 9 GPIO_ACTIVE_HIGH>;   // Ref by connector label
            gpios = <&{/connector} 9 GPIO_ACTIVE_HIGH>;     // Ref by path
        };            
    };

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "User SB1";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
    
    aliases {
        status-led = &led_red;
        sw0 = &user_button; 
    };

    chosen {
        zephyr,console    = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
        zephyr,uart-pipe  = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};    

&gpio0 {
    enc28j60_reset: enc28j60-reset {
        gpio-hog;
        gpios = <20 GPIO_ACTIVE_LOW>;
        output-high;
    };
};

&spi0 {
    cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
    status = "okay";

    enc28j60: ethernet@0 {
        compatible = "microchip,enc28j60";
        reg = <0>;
        spi-max-frequency = <8000000>;
        int-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
        local-mac-address = [00 00 00 01 02 03];
        status = "okay";
    };
};
